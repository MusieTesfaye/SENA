/// The one-step verifier: where a dispute is actually decided.
///
/// Bisection has narrowed the disagreement to a single step. Both parties agree
/// on the state going in; they disagree on the state coming out. This module
/// executes that one step and sees who was right (REQ-FRAUD-017).
///
/// It is the highest-value target in the system. If its semantics diverge from
/// `sena-stf`, it decides disputes wrongly -- slashing an honest sequencer or
/// vindicating a fraudulent one -- so every rule here mirrors `transition()` in
/// `crates/sena-stf/src/execute.rs`, every slot mirrors `keys.rs`, and the
/// conformance vectors in `tests/vectors.move` are generated by the Rust node.
///
/// # Failing steps do not abort
///
/// A step that cannot execute -- a nonce mismatch, an overdraft, a bad council
/// signature -- is not an error here: it is the *finding*. An honest trace
/// never contains one, so a trace that does is fraud, and the caller must be
/// able to act on that. `transition` therefore reports failure as a value. It
/// still aborts on a witness that does not prove against the agreed state,
/// because that is the prover's mistake, not the defender's.
module sena::osp {
    use std::option;
    use std::vector;
    use sena::codec;
    use sena::keyless;
    use sena::trie;
    use sena::gas;

    /// The witness described a slot the instruction does not touch.
    const E_WITNESS_SLOT_MISMATCH: u64 = 20;
    /// The instruction kind is not one this module knows.
    const E_UNSUPPORTED_INSTRUCTION: u64 = 26;
    /// The proof did not describe the state both parties agreed on.
    const E_PRE_STATE_MISMATCH: u64 = 27;

    // Instruction discriminants, matching `Instruction::encode` in Rust.
    const OP_CONSUME_NONCE: u8 = 0;
    const OP_DEBIT: u8 = 1;
    const OP_CREDIT: u8 = 2;
    const OP_BIND_IDENTIFIER: u8 = 3;
    const OP_UNBIND_IDENTIFIER: u8 = 4;
    const OP_VERIFY_GAS_ASSET: u8 = 5;
    const OP_VERIFY_COUNCIL: u8 = 6;
    const OP_SET_GAS_ASSET: u8 = 7;
    const OP_SET_PARAMETER: u8 = 8;
    const OP_VERIFY_JWK: u8 = 9;
    const OP_SET_JWK: u8 = 10;
    const OP_CHARGE_BASE_FEE: u8 = 11;
    const OP_VERIFY_FEE_SPLIT: u8 = 12;
    const OP_SET_FEE_SPLIT: u8 = 13;
    const OP_SET_FEE_MARKET: u8 = 14;
    const OP_DISABLE_GAS_ASSET: u8 = 15;

    const TAG_BOUND: u8 = 0;
    const TAG_VACANT: u8 = 1;

    const MAX_U64: u64 = 18446744073709551615;
    const MAX_U128: u128 = 340282366920938463463374607431768211455;

    // State regions, mirroring `sena_stf::keys`.
    const REGION_ACCOUNT: vector<u8> = b"SENA:v1:state:account";
    const REGION_SOCIAL_BY_IDENTIFIER: vector<u8> = b"SENA:v1:state:social-by-identifier";
    const REGION_ASSET: vector<u8> = b"SENA:v1:state:asset";
    const REGION_PARAMETER: vector<u8> = b"SENA:v1:state:parameter";
    const REGION_COUNCIL: vector<u8> = b"SENA:v1:state:council";
    const REGION_JWK: vector<u8> = b"SENA:v1:state:jwk";
    const REGION_FEE_MARKET: vector<u8> = b"SENA:v1:state:fee-market";
    const REGION_FEE_SPLIT: vector<u8> = b"SENA:v1:state:fee-split";

    /// Outcome of adjudication: the defender's claimed post-state is right.
    const DEFENDER_WINS: u8 = 0;
    /// Outcome of adjudication: the defender's claim is wrong.
    const CHALLENGER_WINS: u8 = 1;

    /// One decoded account balance entry.
    struct Balance has copy, drop, store {
        asset: u32,
        amount: u128,
    }

    /// An account as stored in the trie.
    struct Account has copy, drop, store {
        nonce: u64,
        balances: vector<Balance>,
    }

    /// One instruction, as `sena::compiler` derives it from batch data.
    ///
    /// A superset of fields; each op reads the ones listed. The challenger
    /// never supplies this: if they could name the instruction at the disputed
    /// index they would choose one that fails.
    struct Instruction has copy, drop, store {
        op: u8,
        /// ConsumeNonce/Debit/Credit: the account. Bind: the address bound.
        /// Unbind: the expected owner.
        account: vector<u8>,
        /// Bind/Unbind: the hashed identifier.
        identifier: vector<u8>,
        /// Debit/Credit/VerifyGasAsset/SetGasAsset/DisableGasAsset: the asset.
        asset: u32,
        /// Debit/Credit: the amount. VerifyGasAsset/SetGasAsset: the rate.
        /// SetParameter: the value. ChargeBaseFee: the base fee.
        /// SetFeeMarket: the floor.
        amount: u128,
        /// ConsumeNonce: the expected nonce. VerifyCouncil: the epoch.
        /// ChargeBaseFee: the batch timestamp.
        nonce: u64,
        /// VerifyGasAsset/SetGasAsset: the intrinsic gas. ChargeBaseFee: the
        /// gas charged. SetFeeMarket: the target.
        gas: u64,
        /// VerifyFeeSplit/SetFeeSplit: the split's canonical bytes.
        split: vector<u8>,
        /// VerifyCouncil: the signed update digest.
        digest: vector<u8>,
        /// VerifyCouncil: signer indices and signatures, in order.
        signer_indices: vector<u32>,
        signatures: vector<vector<u8>>,
        /// SetGasAsset: the symbol. SetParameter: the name.
        text: vector<u8>,
        /// SetGasAsset: enabled. SetJwk: active. VerifyCouncil: guardian.
        flag: bool,
        /// VerifyJwk/SetJwk.
        iss_hash: vector<u8>,
        jwk_hash: vector<u8>,
    }

    /// The machine state between two steps.
    struct MachineState has copy, drop, store {
        state_root: vector<u8>,
        pc: u64,
    }

    fun blank(op: u8): Instruction {
        Instruction {
            op,
            account: vector::empty(),
            identifier: vector::empty(),
            asset: 0,
            amount: 0,
            nonce: 0,
            gas: 0,
            split: vector::empty(),
            digest: vector::empty(),
            signer_indices: vector::empty(),
            signatures: vector::empty(),
            text: vector::empty(),
            flag: false,
            iss_hash: vector::empty(),
            jwk_hash: vector::empty(),
        }
    }

    public fun consume_nonce(account: vector<u8>, expected: u64): Instruction {
        let i = blank(OP_CONSUME_NONCE); i.account = account; i.nonce = expected; i
    }
    public fun debit(account: vector<u8>, asset: u32, amount: u128): Instruction {
        let i = blank(OP_DEBIT); i.account = account; i.asset = asset; i.amount = amount; i
    }
    public fun credit(account: vector<u8>, asset: u32, amount: u128): Instruction {
        let i = blank(OP_CREDIT); i.account = account; i.asset = asset; i.amount = amount; i
    }
    public fun bind_identifier(identifier: vector<u8>, address: vector<u8>): Instruction {
        let i = blank(OP_BIND_IDENTIFIER); i.identifier = identifier; i.account = address; i
    }
    public fun unbind_identifier(identifier: vector<u8>, expected_owner: vector<u8>): Instruction {
        let i = blank(OP_UNBIND_IDENTIFIER); i.identifier = identifier; i.account = expected_owner; i
    }
    public fun verify_gas_asset(asset: u32, rate: u128, intrinsic_gas: u64): Instruction {
        let i = blank(OP_VERIFY_GAS_ASSET); i.asset = asset; i.amount = rate; i.gas = intrinsic_gas; i
    }
    public fun verify_council(
        epoch: u64,
        digest: vector<u8>,
        signer_indices: vector<u32>,
        signatures: vector<vector<u8>>,
        guardian: bool,
    ): Instruction {
        let i = blank(OP_VERIFY_COUNCIL);
        i.nonce = epoch; i.digest = digest; i.signer_indices = signer_indices; i.signatures = signatures;
        i.flag = guardian;
        i
    }
    public fun set_gas_asset(
        asset: u32, symbol: vector<u8>, rate: u128, intrinsic_gas: u64, enabled: bool
    ): Instruction {
        let i = blank(OP_SET_GAS_ASSET);
        i.asset = asset; i.text = symbol; i.amount = rate; i.gas = intrinsic_gas; i.flag = enabled;
        i
    }
    public fun charge_base_fee(timestamp: u64, base_fee: u128, gas: u64): Instruction {
        let i = blank(OP_CHARGE_BASE_FEE); i.nonce = timestamp; i.amount = base_fee; i.gas = gas; i
    }
    public fun verify_fee_split(split: vector<u8>): Instruction {
        let i = blank(OP_VERIFY_FEE_SPLIT); i.split = split; i
    }
    public fun set_fee_split(split: vector<u8>): Instruction {
        let i = blank(OP_SET_FEE_SPLIT); i.split = split; i
    }
    public fun set_fee_market(floor: u128, target: u64): Instruction {
        let i = blank(OP_SET_FEE_MARKET); i.amount = floor; i.gas = target; i
    }
    public fun disable_gas_asset(asset: u32): Instruction {
        let i = blank(OP_DISABLE_GAS_ASSET); i.asset = asset; i
    }
    public fun set_parameter(name: vector<u8>, value: u128): Instruction {
        let i = blank(OP_SET_PARAMETER); i.text = name; i.amount = value; i
    }
    public fun verify_jwk(iss_hash: vector<u8>, jwk_hash: vector<u8>): Instruction {
        let i = blank(OP_VERIFY_JWK); i.iss_hash = iss_hash; i.jwk_hash = jwk_hash; i
    }
    public fun set_jwk(iss_hash: vector<u8>, jwk_hash: vector<u8>, active: bool): Instruction {
        let i = blank(OP_SET_JWK); i.iss_hash = iss_hash; i.jwk_hash = jwk_hash; i.flag = active; i
    }

    public fun machine_state(state_root: vector<u8>, pc: u64): MachineState {
        MachineState { state_root, pc }
    }

    /// Commits to a machine state.
    ///
    /// Both the root and the program counter are committed: committing only the
    /// root would let a party claim the same state at a different trace
    /// position, which is the ambiguity bisection exists to remove.
    public fun commit_machine_state(s: &MachineState): vector<u8> {
        let buf = codec::begin(codec::domain_machine_state());
        codec::put_field(&mut buf, s.state_root);
        codec::put_field_u64(&mut buf, s.pc);
        codec::commit(buf)
    }

    // --- Conformance encoding ------------------------------------------------

    /// Encodes an instruction exactly as `Instruction::encode` does in Rust.
    /// Used only to compare the two compilers in conformance tests.
    public fun encode_instruction(i: &Instruction): vector<u8> {
        let out = vector::singleton(i.op);
        if (i.op == OP_CONSUME_NONCE) {
            vector::append(&mut out, i.account);
            codec::put_u64(&mut out, i.nonce);
        } else if (i.op == OP_DEBIT || i.op == OP_CREDIT) {
            vector::append(&mut out, i.account);
            codec::put_u32(&mut out, i.asset);
            codec::put_u128(&mut out, i.amount);
        } else if (i.op == OP_BIND_IDENTIFIER || i.op == OP_UNBIND_IDENTIFIER) {
            vector::append(&mut out, i.identifier);
            vector::append(&mut out, i.account);
        } else if (i.op == OP_VERIFY_GAS_ASSET) {
            codec::put_u32(&mut out, i.asset);
            codec::put_u128(&mut out, i.amount);
            codec::put_u64(&mut out, i.gas);
        } else if (i.op == OP_VERIFY_COUNCIL) {
            codec::put_u64(&mut out, i.nonce);
            vector::append(&mut out, i.digest);
            let n = vector::length(&i.signatures);
            codec::put_u32(&mut out, (n as u32));
            let k = 0;
            while (k < n) {
                codec::put_u32(&mut out, *vector::borrow(&i.signer_indices, k));
                vector::append(&mut out, *vector::borrow(&i.signatures, k));
                k = k + 1;
            };
            codec::put_bool(&mut out, i.flag);
        } else if (i.op == OP_SET_GAS_ASSET) {
            codec::put_field(&mut out, encode_asset_record(i.asset, i.text, i.amount, i.gas, i.flag));
        } else if (i.op == OP_SET_PARAMETER) {
            codec::put_field(&mut out, i.text);
            codec::put_u128(&mut out, i.amount);
        } else if (i.op == OP_VERIFY_JWK) {
            vector::append(&mut out, i.iss_hash);
            vector::append(&mut out, i.jwk_hash);
        } else if (i.op == OP_SET_JWK) {
            vector::append(&mut out, i.iss_hash);
            vector::append(&mut out, i.jwk_hash);
            codec::put_bool(&mut out, i.flag);
        } else if (i.op == OP_CHARGE_BASE_FEE) {
            codec::put_u64(&mut out, i.nonce);
            codec::put_u128(&mut out, i.amount);
            codec::put_u64(&mut out, i.gas);
        } else if (i.op == OP_VERIFY_FEE_SPLIT || i.op == OP_SET_FEE_SPLIT) {
            codec::put_field(&mut out, i.split);
        } else if (i.op == OP_SET_FEE_MARKET) {
            codec::put_u128(&mut out, i.amount);
            codec::put_u64(&mut out, i.gas);
        } else if (i.op == OP_DISABLE_GAS_ASSET) {
            codec::put_u32(&mut out, i.asset);
        } else {
            abort E_UNSUPPORTED_INSTRUCTION
        };
        out
    }

    /// A whitelisted gas asset record, as `WhitelistedAsset::encode` writes it.
    fun encode_asset_record(
        asset: u32, symbol: vector<u8>, rate: u128, intrinsic_gas: u64, enabled: bool
    ): vector<u8> {
        let out = vector::empty<u8>();
        codec::put_u32(&mut out, asset);
        codec::put_field(&mut out, symbol);
        codec::put_u128(&mut out, rate);
        codec::put_u64(&mut out, intrinsic_gas);
        codec::put_bool(&mut out, enabled);
        out
    }

    /// Decodes a stored asset record: `(asset, symbol, rate, intrinsic_gas,
    /// enabled)`.
    fun decode_asset_record(bytes: vector<u8>): (u32, vector<u8>, u128, u64, bool) {
        let r = codec::reader(bytes);
        let asset = codec::take_u32(&mut r);
        let symbol = codec::take_field(&mut r);
        let rate = codec::take_u128(&mut r);
        let intrinsic_gas = codec::take_u64(&mut r);
        let enabled = codec::take_bool(&mut r);
        codec::finish(&r);
        (asset, symbol, rate, intrinsic_gas, enabled)
    }

    // --- Slots ---------------------------------------------------------------

    fun region_key(region: vector<u8>, field: vector<u8>): vector<u8> {
        let buf = codec::begin(region);
        codec::put_field(&mut buf, field);
        codec::commit(buf)
    }

    /// The trie key of an account (`keys::account`).
    public fun account_key(address: vector<u8>): vector<u8> {
        region_key(REGION_ACCOUNT, address)
    }

    /// The single slot an instruction reads and writes (`Instruction::slot`).
    public fun slot_of(i: &Instruction): vector<u8> {
        let op = i.op;
        if (op == OP_CONSUME_NONCE || op == OP_DEBIT || op == OP_CREDIT) {
            account_key(i.account)
        } else if (op == OP_BIND_IDENTIFIER || op == OP_UNBIND_IDENTIFIER) {
            region_key(REGION_SOCIAL_BY_IDENTIFIER, i.identifier)
        } else if (op == OP_VERIFY_GAS_ASSET || op == OP_SET_GAS_ASSET || op == OP_DISABLE_GAS_ASSET) {
            let buf = codec::begin(REGION_ASSET);
            codec::put_field_u64(&mut buf, (i.asset as u64));
            codec::commit(buf)
        } else if (op == OP_VERIFY_COUNCIL) {
            codec::commit(codec::begin(REGION_COUNCIL))
        } else if (op == OP_SET_PARAMETER) {
            region_key(REGION_PARAMETER, i.text)
        } else if (op == OP_VERIFY_JWK || op == OP_SET_JWK) {
            let buf = codec::begin(REGION_JWK);
            codec::put_field(&mut buf, i.iss_hash);
            codec::put_field(&mut buf, i.jwk_hash);
            codec::commit(buf)
        } else if (op == OP_CHARGE_BASE_FEE || op == OP_SET_FEE_MARKET) {
            codec::commit(codec::begin(REGION_FEE_MARKET))
        } else if (op == OP_VERIFY_FEE_SPLIT || op == OP_SET_FEE_SPLIT) {
            codec::commit(codec::begin(REGION_FEE_SPLIT))
        } else {
            abort E_UNSUPPORTED_INSTRUCTION
        }
    }

    /// `gas::instruction_gas`: what one payload instruction costs. The steps
    /// every transaction runs are covered by the intrinsic gas instead.
    public fun instruction_gas(i: &Instruction): u64 {
        let op = i.op;
        if (op == OP_DEBIT || op == OP_CREDIT || op == OP_UNBIND_IDENTIFIER) {
            5000
        } else if (op == OP_VERIFY_COUNCIL) {
            10000 + 3000 * vector::length(&i.signatures)
        } else if (op == OP_BIND_IDENTIFIER || op == OP_SET_GAS_ASSET || op == OP_SET_PARAMETER
            || op == OP_SET_JWK || op == OP_SET_FEE_MARKET || op == OP_SET_FEE_SPLIT
            || op == OP_DISABLE_GAS_ASSET) {
            20000
        } else if (op == OP_VERIFY_FEE_SPLIT) {
            2000
        } else {
            0
        }
    }

    // --- Account codec -------------------------------------------------------

    /// Decodes a stored account, rejecting non-canonical encodings.
    ///
    /// Entries must be in strictly ascending asset order with no zero balances.
    /// Tolerating either would give one account state two valid encodings, and
    /// the trie commits to bytes rather than to meaning.
    public fun decode_account(bytes: vector<u8>): Account {
        let r = codec::reader(bytes);
        let nonce = codec::take_u64(&mut r);
        let count = codec::take_u32(&mut r);

        let balances = vector::empty<Balance>();
        let i: u32 = 0;
        let previous: u64 = 0;
        let seen = false;
        while (i < count) {
            let asset = codec::take_u32(&mut r);
            let amount = codec::take_u128(&mut r);
            assert!(amount > 0, codec::error_not_canonical());
            if (seen) {
                assert!((asset as u64) > previous, codec::error_not_canonical());
            };
            previous = (asset as u64);
            seen = true;
            vector::push_back(&mut balances, Balance { asset, amount });
            i = i + 1;
        };
        codec::finish(&r);
        Account { nonce, balances }
    }

    /// Encodes an account, pruning zero balances.
    public fun encode_account(a: &Account): vector<u8> {
        let buf = vector::empty<u8>();
        codec::put_u64(&mut buf, a.nonce);

        let kept = vector::empty<Balance>();
        let i = 0;
        while (i < vector::length(&a.balances)) {
            let b = *vector::borrow(&a.balances, i);
            if (b.amount > 0) { vector::push_back(&mut kept, b) };
            i = i + 1;
        };

        codec::put_u32(&mut buf, (vector::length(&kept) as u32));
        let j = 0;
        while (j < vector::length(&kept)) {
            let b = *vector::borrow(&kept, j);
            codec::put_u32(&mut buf, b.asset);
            codec::put_u128(&mut buf, b.amount);
            j = j + 1;
        };
        buf
    }

    /// An account that has never been touched: zero nonce, no balances.
    public fun empty_account(): Account {
        Account { nonce: 0, balances: vector::empty<Balance>() }
    }

    /// Returns an account's balance in an asset.
    ///
    /// Public so the bridge can read a proven account's balance rather than
    /// taking the withdrawal amount as an argument, which would make the proof
    /// decorative.
    public fun account_balance(a: &Account, asset: u32): u128 {
        balance_of(a, asset)
    }

    fun balance_of(a: &Account, asset: u32): u128 {
        let i = 0;
        while (i < vector::length(&a.balances)) {
            let b = vector::borrow(&a.balances, i);
            if (b.asset == asset) { return b.amount };
            i = i + 1;
        };
        0
    }

    /// Sets a balance, keeping entries in ascending asset order.
    fun set_balance(a: &mut Account, asset: u32, amount: u128) {
        let i = 0;
        let len = vector::length(&a.balances);
        while (i < len) {
            let b = vector::borrow(&a.balances, i);
            if (b.asset == asset) {
                if (amount == 0) {
                    vector::remove(&mut a.balances, i);
                } else {
                    vector::borrow_mut(&mut a.balances, i).amount = amount;
                };
                return
            };
            if (b.asset > asset) { break };
            i = i + 1;
        };
        if (amount > 0) {
            vector::insert(&mut a.balances, i, Balance { asset, amount });
        };
    }

    fun account_in(present: bool, current: vector<u8>): Account {
        if (present) { decode_account(current) } else { empty_account() }
    }

    // --- Step semantics ------------------------------------------------------

    /// Applies one instruction to a slot's contents.
    ///
    /// Returns `(true, new contents)`, or `(false, _)` if the step cannot
    /// execute -- which means the trace containing it is invalid. Mirrors
    /// `sena_stf::transition`. `present` distinguishes an empty slot from a
    /// slot holding empty bytes.
    public fun transition(
        instruction: &Instruction,
        present: bool,
        current: vector<u8>,
    ): (bool, vector<u8>) {
        let op = instruction.op;
        if (op == OP_CONSUME_NONCE) {
            let a = account_in(present, current);
            if (a.nonce != instruction.nonce) { return (false, vector::empty()) };
            // Checked: a wrap would silently re-enable every used nonce.
            if (a.nonce == MAX_U64) { return (false, vector::empty()) };
            a.nonce = a.nonce + 1;
            (true, encode_account(&a))
        } else if (op == OP_DEBIT) {
            let a = account_in(present, current);
            if (instruction.amount > 0) {
                let held = balance_of(&a, instruction.asset);
                if (held < instruction.amount) { return (false, vector::empty()) };
                set_balance(&mut a, instruction.asset, held - instruction.amount);
            };
            (true, encode_account(&a))
        } else if (op == OP_CREDIT) {
            let a = account_in(present, current);
            if (instruction.amount > 0) {
                let held = balance_of(&a, instruction.asset);
                if (MAX_U128 - held < instruction.amount) { return (false, vector::empty()) };
                set_balance(&mut a, instruction.asset, held + instruction.amount);
            };
            (true, encode_account(&a))
        } else if (op == OP_BIND_IDENTIFIER) {
            if (present) {
                let r = codec::reader(current);
                let tag = codec::take_u8(&mut r);
                if (tag == TAG_BOUND) {
                    let holder = codec::take_bytes(&mut r, 32);
                    codec::finish(&r);
                    // Re-binding to the same address is idempotent; taking
                    // someone else's identifier is not permitted.
                    if (holder != instruction.account) { return (false, vector::empty()) };
                } else {
                    assert!(tag == TAG_VACANT, codec::error_unknown_variant());
                    codec::finish(&r);
                };
            };
            let out = vector::singleton(TAG_BOUND);
            vector::append(&mut out, instruction.account);
            (true, out)
        } else if (op == OP_UNBIND_IDENTIFIER) {
            if (!present) { return (false, vector::empty()) };
            let r = codec::reader(current);
            let tag = codec::take_u8(&mut r);
            if (tag != TAG_BOUND) {
                assert!(tag == TAG_VACANT, codec::error_unknown_variant());
                codec::finish(&r);
                return (false, vector::empty())
            };
            let holder = codec::take_bytes(&mut r, 32);
            codec::finish(&r);
            if (holder != instruction.account) { return (false, vector::empty()) };
            // Overwritten with a vacant marker rather than removed: removal can
            // require collapsing a branch, whose shape the proof does not
            // describe.
            (true, vector::singleton(TAG_VACANT))
        } else if (op == OP_VERIFY_GAS_ASSET) {
            if (!present) { return (false, vector::empty()) };
            let (_, _, rate, intrinsic_gas, enabled) = decode_asset_record(current);
            if (!enabled || rate != instruction.amount || intrinsic_gas != instruction.gas) {
                return (false, vector::empty())
            };
            // Read-only: written back unchanged.
            (true, current)
        } else if (op == OP_CHARGE_BASE_FEE) {
            let (ok, market) = gas::market_at(&gas::market_in(present, current), instruction.nonce);
            if (!ok || gas::base_fee(&market) != instruction.amount) { return (false, vector::empty()) };
            if (!gas::charge(&mut market, instruction.gas)) { return (false, vector::empty()) };
            (true, gas::encode_market(&market))
        } else if (op == OP_VERIFY_FEE_SPLIT) {
            if (!present || current != instruction.split) { return (false, vector::empty()) };
            (true, current)
        } else if (op == OP_SET_FEE_SPLIT) {
            if (!gas::split_is_valid(instruction.split)) { return (false, vector::empty()) };
            (true, instruction.split)
        } else if (op == OP_SET_FEE_MARKET) {
            if (instruction.amount == 0 || instruction.gas == 0) { return (false, vector::empty()) };
            let market = gas::market_in(present, current);
            gas::set_parameters(&mut market, instruction.amount, instruction.gas);
            (true, gas::encode_market(&market))
        } else if (op == OP_DISABLE_GAS_ASSET) {
            if (!present) { return (false, vector::empty()) };
            let (asset, symbol, rate, intrinsic_gas, _) = decode_asset_record(current);
            (true, encode_asset_record(asset, symbol, rate, intrinsic_gas, false))
        } else if (op == OP_VERIFY_COUNCIL) {
            if (!present) { return (false, vector::empty()) };
            verify_council_step(instruction, current)
        } else if (op == OP_SET_GAS_ASSET) {
            // A zero rate would make every fee round to zero.
            if (instruction.amount == 0) { return (false, vector::empty()) };
            (true, encode_asset_record(
                instruction.asset, instruction.text, instruction.amount, instruction.gas, instruction.flag
            ))
        } else if (op == OP_SET_PARAMETER) {
            if (!is_governable(&instruction.text)) { return (false, vector::empty()) };
            let out = vector::empty<u8>();
            codec::put_u128(&mut out, instruction.amount);
            (true, out)
        } else if (op == OP_VERIFY_JWK) {
            if (!present || current != vector::singleton(1u8)) { return (false, vector::empty()) };
            (true, current)
        } else if (op == OP_SET_JWK) {
            (true, vector::singleton(if (instruction.flag) { 1u8 } else { 0u8 }))
        } else {
            abort E_UNSUPPORTED_INSTRUCTION
        }
    }

    /// `GOVERNABLE_PARAMETERS` in `sena_stf::governance`.
    public fun is_governable(name: &vector<u8>): bool {
        *name == b"batch.max_transactions"
    }

    /// Checks council signatures and consumes the epoch.
    ///
    /// Mirrors `verify_council_signatures` and the `VerifyCouncil` arm of
    /// `transition`: the epoch must be the council's current one; indices must
    /// be strictly increasing and in range; every signature must verify
    /// strictly; at least `threshold` must be supplied; and the record is
    /// written back with the epoch advanced.
    fun verify_council_step(instruction: &Instruction, current: vector<u8>): (bool, vector<u8>) {
        let r = codec::reader(current);
        let count = codec::take_u32(&mut r);
        let members = vector::empty<vector<u8>>();
        let i = 0;
        while (i < count) {
            vector::push_back(&mut members, codec::take_bytes(&mut r, 32));
            i = i + 1;
        };
        let threshold = codec::take_u32(&mut r);
        let epoch = codec::take_u64(&mut r);
        let guardian_threshold = codec::take_u32(&mut r);
        codec::finish(&r);

        // `Council::required`: the guardian threshold suffices only for a
        // guardian payload, and only if the council has one.
        let required = if (instruction.flag && guardian_threshold > 0) { guardian_threshold } else { threshold };
        if (epoch != instruction.nonce || required == 0) { return (false, vector::empty()) };

        let n = vector::length(&instruction.signatures);
        let k = 0;
        let previous: u64 = 0;
        while (k < n) {
            let index = (*vector::borrow(&instruction.signer_indices, k) as u64);
            if (k > 0 && index <= previous) { return (false, vector::empty()) };
            previous = index;
            if (index >= (count as u64)) { return (false, vector::empty()) };
            let member = vector::borrow(&members, index);
            if (!keyless::verify_ed25519_strict(member, vector::borrow(&instruction.signatures, k), &instruction.digest)) {
                return (false, vector::empty())
            };
            k = k + 1;
        };
        if (n < (required as u64)) { return (false, vector::empty()) };
        if (epoch == MAX_U64) { return (false, vector::empty()) };

        let out = vector::empty<u8>();
        codec::put_u32(&mut out, count);
        let m = 0;
        while (m < count) {
            vector::append(&mut out, *vector::borrow(&members, (m as u64)));
            m = m + 1;
        };
        codec::put_u32(&mut out, threshold);
        codec::put_u64(&mut out, epoch + 1);
        codec::put_u32(&mut out, guardian_threshold);
        (true, out)
    }

    /// Verifies one step and returns the machine state honest execution
    /// produces, or `none` if the step cannot execute.
    ///
    /// The witness is checked before it is trusted: it must describe the slot
    /// the instruction touches (derived here, never supplied), and its claimed
    /// contents must prove against the pre-state root. A bad witness aborts.
    public fun verify_step(
        pre: &MachineState,
        instruction: &Instruction,
        slot: vector<u8>,
        present: bool,
        value: vector<u8>,
        proof: &trie::Proof,
    ): option::Option<MachineState> {
        assert!(slot == slot_of(instruction), E_WITNESS_SLOT_MISMATCH);

        if (present) {
            trie::verify_inclusion(proof, pre.state_root, slot, trie::hash_value(value));
        } else {
            trie::verify_non_inclusion(proof, pre.state_root, slot);
        };

        let (ok, updated) = transition(instruction, present, value);
        if (!ok) { return option::none() };
        let post_root = trie::compute_updated_root(proof, slot, trie::hash_value(updated));
        option::some(MachineState { state_root: post_root, pc: pre.pc + 1 })
    }

    /// Settles a dispute narrowed to one step: `DEFENDER_WINS` if honest
    /// execution reproduces the claimed post-state, `CHALLENGER_WINS` if it
    /// produces a different one or the step cannot execute at all.
    public fun adjudicate(
        pre: &MachineState,
        agreed_pre_commitment: vector<u8>,
        claimed_post_commitment: vector<u8>,
        instruction: &Instruction,
        slot: vector<u8>,
        present: bool,
        value: vector<u8>,
        proof: &trie::Proof,
    ): u8 {
        assert!(commit_machine_state(pre) == agreed_pre_commitment, E_PRE_STATE_MISMATCH);
        let post = verify_step(pre, instruction, slot, present, value, proof);
        if (option::is_none(&post)) { return CHALLENGER_WINS };
        if (commit_machine_state(&option::extract(&mut post)) == claimed_post_commitment) {
            DEFENDER_WINS
        } else {
            CHALLENGER_WINS
        }
    }

    public fun defender_wins(): u8 { DEFENDER_WINS }
    public fun challenger_wins(): u8 { CHALLENGER_WINS }
    public fun op_of(i: &Instruction): u8 { i.op }

    #[test_only]
    /// Decodes an instruction from `Instruction::encode` bytes, so conformance
    /// tests can replay Rust's transitions.
    public fun decode_instruction(bytes: vector<u8>): Instruction {
        let r = codec::reader(bytes);
        let op = codec::take_u8(&mut r);
        let i = blank(op);
        if (op == OP_CONSUME_NONCE) {
            i.account = codec::take_bytes(&mut r, 32);
            i.nonce = codec::take_u64(&mut r);
        } else if (op == OP_DEBIT || op == OP_CREDIT) {
            i.account = codec::take_bytes(&mut r, 32);
            i.asset = codec::take_u32(&mut r);
            i.amount = codec::take_u128(&mut r);
        } else if (op == OP_BIND_IDENTIFIER || op == OP_UNBIND_IDENTIFIER) {
            i.identifier = codec::take_bytes(&mut r, 32);
            i.account = codec::take_bytes(&mut r, 32);
        } else if (op == OP_VERIFY_GAS_ASSET) {
            i.asset = codec::take_u32(&mut r);
            i.amount = codec::take_u128(&mut r);
            i.gas = codec::take_u64(&mut r);
        } else if (op == OP_VERIFY_COUNCIL) {
            i.nonce = codec::take_u64(&mut r);
            i.digest = codec::take_bytes(&mut r, 32);
            let n = codec::take_u32(&mut r);
            let k = 0;
            while (k < n) {
                vector::push_back(&mut i.signer_indices, codec::take_u32(&mut r));
                vector::push_back(&mut i.signatures, codec::take_bytes(&mut r, 64));
                k = k + 1;
            };
            i.flag = codec::take_bool(&mut r);
        } else if (op == OP_SET_GAS_ASSET) {
            let (asset, symbol, rate, intrinsic_gas, enabled) = decode_asset_record(codec::take_field(&mut r));
            i.asset = asset; i.text = symbol; i.amount = rate; i.gas = intrinsic_gas; i.flag = enabled;
        } else if (op == OP_SET_PARAMETER) {
            i.text = codec::take_field(&mut r);
            i.amount = codec::take_u128(&mut r);
        } else if (op == OP_VERIFY_JWK || op == OP_SET_JWK) {
            i.iss_hash = codec::take_bytes(&mut r, 32);
            i.jwk_hash = codec::take_bytes(&mut r, 32);
            if (op == OP_SET_JWK) { i.flag = codec::take_bool(&mut r) };
        } else if (op == OP_CHARGE_BASE_FEE) {
            i.nonce = codec::take_u64(&mut r);
            i.amount = codec::take_u128(&mut r);
            i.gas = codec::take_u64(&mut r);
        } else if (op == OP_VERIFY_FEE_SPLIT || op == OP_SET_FEE_SPLIT) {
            i.split = codec::take_field(&mut r);
        } else if (op == OP_SET_FEE_MARKET) {
            i.amount = codec::take_u128(&mut r);
            i.gas = codec::take_u64(&mut r);
        } else if (op == OP_DISABLE_GAS_ASSET) {
            i.asset = codec::take_u32(&mut r);
        } else {
            abort E_UNSUPPORTED_INSTRUCTION
        };
        codec::finish(&r);
        i
    }

    // --- Conformance tests ---------------------------------------------------

    #[test]
    fun empty_account_encoding_matches_rust() {
        assert!(encode_account(&empty_account()) == x"000000000000000000000000", 0);
    }

    #[test]
    fun funded_account_encoding_matches_rust() {
        // account{nonce: 5, asset 1 -> 1000, asset 7 -> 42}
        let a = empty_account();
        a.nonce = 5;
        set_balance(&mut a, 1, 1000);
        set_balance(&mut a, 7, 42);
        assert!(
            encode_account(&a)
                == x"00000000000000050000000200000001000000000000000000000000000003e8000000070000000000000000000000000000002a",
            0
        );
    }

    #[test]
    fun account_decoding_round_trips() {
        let bytes = x"00000000000000050000000200000001000000000000000000000000000003e8000000070000000000000000000000000000002a";
        let a = decode_account(bytes);
        assert!(a.nonce == 5, 0);
        assert!(balance_of(&a, 1) == 1000, 1);
        assert!(balance_of(&a, 7) == 42, 2);
        assert!(encode_account(&a) == bytes, 3);
    }

    #[test]
    // The abort originates where the `assert!` is, which is this module --
    // borrowing the error code from `codec` does not move the abort there.
    #[expected_failure(abort_code = 4, location = Self)]
    fun out_of_order_balances_are_rejected() {
        // asset 9 before asset 1: a second encoding of one account state.
        decode_account(x"00000000000000000000000200000009000000000000000000000000000000010000000100000000000000000000000000000001");
    }

    #[test]
    fun machine_commitment_matches_rust() {
        let root = vector::empty<u8>();
        let i = 0;
        while (i < 32) { vector::push_back(&mut root, 0x55); i = i + 1; };
        let s = machine_state(root, 7);
        assert!(
            commit_machine_state(&s)
                == x"76acaa5e43222dde525837b3bdcd9495097c4a5ed4a0b11c98a23b02c5508569",
            0
        );
    }

    #[test]
    fun commitment_distinguishes_trace_position() {
        let root = vector::empty<u8>();
        let i = 0;
        while (i < 32) { vector::push_back(&mut root, 0x55); i = i + 1; };
        let a = machine_state(root, 4);
        let b = machine_state(root, 5);
        assert!(commit_machine_state(&a) != commit_machine_state(&b), 0);
    }

    fun addr(byte: u8): vector<u8> {
        let v = vector::empty<u8>();
        let i = 0;
        while (i < 32) { vector::push_back(&mut v, byte); i = i + 1; };
        v
    }

    #[test]
    fun crediting_a_fresh_account_creates_it() {
        let (ok, out) = transition(&credit(addr(1), 1, 500), false, vector::empty());
        assert!(ok, 0);
        let a = decode_account(out);
        assert!(a.nonce == 0, 1);
        assert!(balance_of(&a, 1) == 500, 2);
    }

    #[test]
    fun spending_to_zero_equals_never_having_held() {
        let (_, funded) = transition(&credit(addr(1), 1, 100), false, vector::empty());
        let (ok, spent) = transition(&debit(addr(1), 1, 100), true, funded);
        assert!(ok, 0);
        assert!(spent == encode_account(&empty_account()), 1);
    }

    #[test]
    fun failing_steps_are_reported_not_aborted() {
        let (_, funded) = transition(&credit(addr(1), 1, 100), false, vector::empty());
        let (ok, _) = transition(&debit(addr(1), 1, 1000000), true, funded);
        assert!(!ok, 0);
        let (_, bumped) = transition(&consume_nonce(addr(1), 0), false, vector::empty());
        let (ok, _) = transition(&consume_nonce(addr(1), 0), true, bumped);
        assert!(!ok, 1);
        let (ok, _) = transition(&verify_jwk(addr(2), addr(3)), false, vector::empty());
        assert!(!ok, 2);
        let (ok, _) = transition(&set_parameter(b"challenge_window", 0), false, vector::empty());
        assert!(!ok, 3);
    }

    #[test]
    fun an_identifier_cannot_be_taken_from_its_holder() {
        let (_, bound) = transition(&bind_identifier(addr(9), addr(1)), false, vector::empty());
        let (ok, _) = transition(&bind_identifier(addr(9), addr(2)), true, bound);
        assert!(!ok, 0);
        let (ok, released) = transition(&unbind_identifier(addr(9), addr(1)), true, bound);
        assert!(ok && released == vector::singleton(TAG_VACANT), 1);
    }

    #[test]
    fun a_disabled_asset_is_written_as_disabled() {
        // The previous verifier always wrote `enabled = 1`, so an honest
        // sequencer disabling an asset lost the dispute over it.
        let (ok, record) = transition(&set_gas_asset(1, b"USDC", 1000000, 10000, false), false, vector::empty());
        assert!(ok, 0);
        assert!(*vector::borrow(&record, vector::length(&record) - 1) == 0, 1);
        let (ok, _) = transition(&verify_gas_asset(1, 1000000, 10000), true, record);
        assert!(!ok, 2);
    }

    #[test]
    #[expected_failure(abort_code = E_UNSUPPORTED_INSTRUCTION)]
    fun an_unknown_instruction_is_refused_rather_than_guessed() {
        transition(&blank(99), false, vector::empty());
    }
}
